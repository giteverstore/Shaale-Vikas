<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="@drawable/handle_bar" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make a Pledge"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="4dp" />

    <!-- Need Title -->
    <TextView
        android:id="@+id/tv_need_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- Pledge Type Toggle Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/toggle_bg"
        android:padding="4dp">

        <!-- Pledge Funds Button -->
        <TextView
            android:id="@+id/btn_funds"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="💰 Pledge Funds"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/toggle_selected"
            android:clickable="true"
            android:focusable="true" />

        <!-- Donate Item Button -->
        <TextView
            android:id="@+id/btn_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📦 Donate Item"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Hidden RadioGroup for logic -->
    <RadioGroup
        android:id="@+id/rg_pledge_type"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <RadioButton
            android:id="@+id/rb_funds"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:checked="true" />
        <RadioButton
            android:id="@+id/rb_item"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </RadioGroup>

    <!-- FUNDS SECTION -->
    <LinearLayout
        android:id="@+id/section_funds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Amount -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pledge Amount (₹) *"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Message for Funds -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message (optional)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message_funds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ITEM SECTION -->
    <LinearLayout
        android:id="@+id/section_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Item Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item Description *"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:hint="e.g. 5 sets of paints for the wall"
                android:maxLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Message for Item -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message (optional)"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_message_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:lines="2"
                android:maxLines="4" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Confirm Pledge Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_pledge"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="CONFIRM PLEDGE 🎉"
        android:textSize="15sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/primary_green" />

    <!-- Disclaimer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No real money involved — simulated commitment"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

</LinearLayout>